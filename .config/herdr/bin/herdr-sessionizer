#!/usr/bin/env bash

# Herdr sessionizer — fzf a project dir, then focus or create its workspace.
# Port of ~/.local/bin/tmux-sessionizer (tmux sessions -> herdr workspaces).
# Project discovery is shared with the tmux version via list-projects.sh.

set -uo pipefail

candidates=$(~/.config/scripts/list-projects.sh)
[[ -z "$candidates" ]] && { echo "No project directories found"; exit 1; }

selected=$(sed "s|^$HOME|~|" <<<"$candidates" | fzf --prompt='project> ' --height=100%)
[[ -z "$selected" ]] && exit 0
selected="${selected/#\~/$HOME}"

# Basenames collide across roots (frontend/auth-lambda vs serverless/auth-lambda)
# and the lookup below matches on label — so qualify ambiguous names with their
# parent dir, otherwise selecting one focuses the other's workspace.
base=$(basename "$selected")
if (( $(grep -c "/${base}\$" <<<"$candidates") > 1 )); then
  label="$(basename "$(dirname "$selected")")-${base}"
else
  label="$base"
fi
label="${label//./_}"

existing=$(herdr workspace list |
  jq -r --arg l "$label" 'first(.result.workspaces[] | select(.label == $l) | .workspace_id) // empty')

if [[ -n "$existing" ]]; then
  herdr workspace focus "$existing" >/dev/null
else
  herdr workspace create --cwd "$selected" --label "$label" --focus >/dev/null
fi
